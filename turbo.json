{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": [
        "PORT",
        "NODE_ENV",
        "GATEWAY_ORIGIN",
        "SKIP_ENV_VALIDATION",
        "GATEWAY_PORT",
        "DATABASE_URL",
        "ENCRYPTION_KEY",
        "SESSION_SECRET",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD",
        "MCP_BEARER_TOKEN",
        "MCP_ALLOWED_HOSTS",
        "MCP_WOO_URL",
        "MCP_NOTES_URL",
        "MCP_UTILS_URL",
        "MCP_AUTH_TOKEN",
        "WC_BASE_URL",
        "WC_PUBLIC_HOST",
        "WC_CONSUMER_KEY",
        "WC_CONSUMER_SECRET"
      ],
      "persistent": true
    },
    "db:generate": {},
    "db:migrate": {},
    "db:seed": {
      "cache": false
    }
  }
}
