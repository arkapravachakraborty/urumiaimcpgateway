{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "passThroughEnv": ["PORT", "MCP_BEARER_TOKEN", "MCP_ALLOWED_HOSTS"],
      "persistent": true
    },
    "db:generate": {},
    "db:migrate": {},
    "db:seed": {
      "cache": false
    }
  }
}
