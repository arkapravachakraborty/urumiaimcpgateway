# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# ── Auth / Crypto ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,dashboard.localtest.me

# ── Admin seed ────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── LLM provider (google | openai-compatible) ────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── WooCommerce upstream ──────────────────────────────────
WC_BASE_URL=
WC_PUBLIC_HOST=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
MCP_AUTH_TOKEN=

# ── Ports (dev) ───────────────────────────────────────────
GATEWAY_PORT=4000
WEB_PORT=3000

# Local MCP upstream endpoints and optional Woo MCP bearer authentication
MCP_WOO_URL=http://127.0.0.1:3003/mcp
MCP_NOTES_URL=http://127.0.0.1:3001/mcp
MCP_UTILS_URL=http://127.0.0.1:3002/mcp
