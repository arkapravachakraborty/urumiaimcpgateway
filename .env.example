# Copy this file to .env for local use. Keep real credentials in .env only.

# Local development database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev?schema=public

# Kubernetes database credentials (generated when empty)
POSTGRES_USER=gateway
POSTGRES_DATABASE=gateway
POSTGRES_PASSWORD=

# Authentication and encryption (generated when empty)
ENCRYPTION_KEY=
SESSION_SECRET=
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,dashboard.localtest.me
ADMIN_EMAIL=admin@localtest.me
ADMIN_PASSWORD=

# Gateway chat provider (optional, server-side only)
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
GATEWAY_INTERNAL_URL=

# WooCommerce upstream
WC_BASE_URL=
WC_PUBLIC_HOST=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
MCP_AUTH_TOKEN=
MCP_WOO_TOKEN=
MCP_NOTES_TOKEN=
MCP_UTILS_TOKEN=

# Locally-run service ports and MCP upstream endpoints
GATEWAY_PORT=4000
WEB_PORT=3000
MCP_WOO_URL=http://127.0.0.1:3003/mcp
MCP_NOTES_URL=http://127.0.0.1:3001/mcp
MCP_UTILS_URL=http://127.0.0.1:3002/mcp

# Kubernetes/local-store credentials (generated when empty)
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
WORDPRESS_ADMIN_PASSWORD=

# Optional end-to-end test settings
E2E_GATEWAY_URL=http://dashboard.localtest.me:8080
E2E_NAMESPACE=platform
E2E_CHAT=false
